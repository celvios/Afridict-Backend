NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Supply database credentials through your local environment or secret manager.
DATABASE_URL=
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Hosted OIDC provider configuration. Enable only after selecting a provider
# that owns password credentials and federates Google accounts safely.
OIDC_AUTHORIZATION_URL=
OIDC_CLIENT_ID=
AUTH_METHODS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
DOCS_ENABLED=true
FINANCIAL_MODE=disabled
# Twilio Verify is disabled unless all four values are supplied through a local
# environment or secret manager. The API key secret must never reach a browser.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
ABUSE_HASH_KEY=
# Persona is disabled unless all four values are supplied through a local
# environment or secret manager. Use comma-separated secrets during rotation.
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_API_VERSION=
PERSONA_WEBHOOK_SECRETS=
# Only the reviewed Swervpay sandbox boundary is available. Production remains
# fail closed until commercial, finance, legal and security approvals are recorded.
SWERVPAY_ENVIRONMENT=
SWERVPAY_BUSINESS_ID=
SWERVPAY_SECRET_KEY=
SWERVPAY_DATA_HASH_KEY=
SWERVPAY_DATA_ENCRYPTION_KEY=
