NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Supply database credentials through your local environment or secret manager.
DATABASE_URL=
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Hosted OIDC provider configuration. Enable only after selecting a provider
# that owns password credentials and federates Google accounts safely.
OIDC_AUTHORIZATION_URL=
OIDC_CLIENT_ID=
AUTH_METHODS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
DOCS_ENABLED=true
FINANCIAL_MODE=disabled
# Twilio Verify is disabled unless all four values are supplied through a local
# environment or secret manager. The API key secret must never reach a browser.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
ABUSE_HASH_KEY=
